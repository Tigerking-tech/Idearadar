# ---------- 站点 ----------
# 用于 canonical / sitemap / robots / OG 绝对地址；上线前改成真实域名
NEXT_PUBLIC_SITE_URL="https://rantradar.app"

# ---------- 数据库（模板默认 SQLite） ----------
DATABASE_URL="file:./dev.db"

# ---------- Creem 支付（Merchant of Record） ----------
CREEM_API_KEY="creem_test_replace_me"
CREEM_WEBHOOK_SECRET="whsec_replace_me"
CREEM_API_URL="https://test-api.creem.io"
CREEM_PRICING_TABLE_ID=""
# 在 Creem 后台创建两个订阅产品后填入，定价按钮会自动走 /api/checkout
CREEM_PRODUCT_PRO=""
CREEM_PRODUCT_TEAM=""
SUCCESS_URL="http://localhost:3000/account"

# ---------- 认证（better-auth） ----------
BETTER_AUTH_SECRET="replace_with_a_long_random_string"
BETTER_AUTH_URL="http://localhost:3000"

# ---------- 采集 workflow（GitHub Actions Secrets / Variables） ----------
# GITHUB_TOKEN 由 Actions 自动注入，无需手动设置
# INGEST_WEBHOOK_URL=""      # 可选：采集完成后回推外部系统
# INGEST_QUERY_LIMIT=""      # 可选：限制每个 niche 的查询数，便于本地快速验证
# ENABLE_REDDIT="false"      # 默认关闭；仅当你持有 Reddit 商业数据授权时设为 true
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# REDDIT_USER_AGENT=""
